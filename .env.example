# ─────────────────────────────────────────────────────────────
# LLM configuration (Module 4) — PICK ONE PROVIDER BLOCK.
# Without any key, report_generator.py automatically uses its
# deterministic fallback and the pipeline still runs end-to-end.
#
# PROVIDER picks which block is used; if omitted, the first
# provider with an API key set below is used automatically.
# <PROVIDER>_MODEL is optional — a sensible default is built in.
# ─────────────────────────────────────────────────────────────

# --- OpenAI ---
PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
# PROVIDER=gemini
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.8-flash

# --- OpenRouter (any model id, e.g. meta-llama/llama-3.3-70b-instruct) ---
# PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- NVIDIA NIM ---
# PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
